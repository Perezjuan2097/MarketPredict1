# --- Entorno ---
APP_ENV=development            # production en Render
FLASK_DEBUG=false              # nunca true en producción
SECRET_KEY=                    # obligatoria en producción: python -c "import secrets;print(secrets.token_hex(32))"
LOG_LEVEL=INFO
RATE_LIMIT_PER_MINUTE=120

# --- Administración (provisional hasta tener roles en BD) ---
ADMIN_TOKEN=                   # vacío = panel /admin desactivado

# --- Datos ---
USE_DEMO=false                 # true solo para desarrollo sin red: datos SINTÉTICOS, no reales

# --- Modelo (valores por defecto; editables desde /admin) ---
MODEL_WINDOW=20
MODEL_HORIZON=5
ALERT_DROP=2
MODEL_VERSION=ML-Linear-1.0

# --- Noticias alternativas (opcional; gratis en finnhub.io/register) ---
# FINNHUB_API_KEY=

# --- Cuentas y base de datos ---
AUTO_CREATE_TABLES=false       # true crea las tablas que falten al arrancar (no borra ni modifica datos)

# --- Modelos opcionales ---
ENABLE_TS_MODELS=false         # true activa ARIMA/SARIMA (requiere statsmodels; más lentos)

# --- Base de datos (Supabase/PostgreSQL) ---
# Cadena "Session pooler" del botón Connect de Supabase. Solo aquí o en las variables de Render; nunca en el chat ni en GitHub.
# DATABASE_URL=postgresql://postgres.PROYECTO:CONTRASEÑA@aws-0-REGION.pooler.supabase.com:5432/postgres
