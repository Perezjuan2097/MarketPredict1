# --- Entorno ---
APP_ENV=development            # production en Render
FLASK_DEBUG=false              # nunca true en producción
SECRET_KEY=                    # obligatoria en producción: python -c "import secrets;print(secrets.token_hex(32))"
LOG_LEVEL=INFO
RATE_LIMIT_PER_MINUTE=120

# --- Administración (provisional hasta tener roles en BD) ---
ADMIN_TOKEN=                   # vacío = panel /admin desactivado

# --- Datos ---
USE_DEMO=false                 # true solo para desarrollo sin red: datos SINTÉTICOS, no reales

# --- Modelo (valores por defecto; editables desde /admin) ---
MODEL_WINDOW=20
MODEL_HORIZON=5
ALERT_DROP=2
MODEL_VERSION=ML-Linear-1.0

# --- Base de datos (Fase siguiente: Supabase/PostgreSQL) ---
# DATABASE_URL=postgresql://USUARIO:CONTRASEÑA@HOST:5432/postgres
